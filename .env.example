# Copy to .env and fill in. .env is gitignored; this file holds names only, never values.
# Keys never live in the Obsidian vault and never in handoffs/.env.

# --- Core (product-safe layer) -------------------------------------------------
# Exa is the spine source: category:"people" returns a structured person entity.
# Free under the $10/month resetting credit (~2,500 people searches/month).
EXA_API_KEY=

# TinyFish news search. Verified $0.00/call, used as the default news route.
TINYFISH_API_KEY=

# GitHub Search. Works unauthenticated at 10 req/min; the token is required in
# practice for anything beyond a handful of lookups (5,000 req/hr, 30/min search).
GITHUB_TOKEN=

# YouTube Data API v3. Free, 10,000 units/day shared across endpoints.
YOUTUBE_API_KEY=

# Podcast Index. Free, feed-level podcast and episode metadata.
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# OpenAlex polite pool. Not a key, just an email address for the User-Agent.
OPENALEX_EMAIL=

# Semantic Scholar. Free, but keyless requests 429 by roughly the third call.
SEMANTIC_SCHOLAR_API_KEY=
